# Sitenin adresi. Varsayilan https://www.aisolutionhouse.com (src/content/site.ts);
# on izleme gibi farkli bir ortamda canonical / og adreslerini degistirmek icin.
# NEXT_PUBLIC_SITE_URL=https://www.aisolutionhouse.com

# Uretim derlemesi arama motorlarina aciktir. Yayindan once kapali tutmak icin:
# NEXT_PUBLIC_NOINDEX=1

# Google Search Console'un sagladigi dogrulama kodu (istege bagli):
# GOOGLE_SITE_VERIFICATION=

# Iletisim formu Resend uzerinden mail atar (docs/deployment.md). Anahtar yoksa
# form "gonderilemedi" der ve yazilanlari tarayicida saklar. Gizli tutulur;
# NEXT_PUBLIC_ oneki almaz.
RESEND_API_KEY=
# Istege bagli. Varsayilanlar: alici src/content/contact.ts'teki adres
# (hello@aisolutionhouse.com), gonderen "AI Solution House <form@aisolutionhouse.com>".
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=

# Supabase projesinin acik baglanti bilgileri. Secret/service_role kullanilmaz.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
